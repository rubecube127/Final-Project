# Square One — every environment variable this app reads.
#
# WHERE THIS FILE CAN LIVE
# The server searches upward and uses the first .env it finds:
#
#     1. <repo>/backend/.env
#     2. <repo>/.env                  <- this repo's own folder
#     3. <one folder above the repo>/.env
#     4. <two folders above the repo>/.env
#
# Steps 2 and 3 are the ones that matter when this repo is cloned into a folder
# alongside other submissions, with a shared .env one level above it. A real
# environment variable always beats a file. On boot the server prints which
# file it loaded, or lists every path it searched if it found none.
#
# Never commit a real .env — it is listed in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────
# The only key this app needs. Used for every model call, through Portkey.
PORTKEY_API_KEY=your-portkey-key-here

# ── Optional: all of these have working defaults ──────────────────────────
# The gateway the key is used against.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# The model every agent uses.
MODEL_NAME=gpt-6-luna

# Port for the Express backend. The Vite dev server proxies /api to it.
PORT=3001

# Prices in US dollars per 1,000,000 tokens, used to report cost on screen.
# PRICE_CACHED_PER_MTOK defaults to one tenth of PRICE_INPUT_PER_MTOK.
PRICE_INPUT_PER_MTOK=1.25
PRICE_OUTPUT_PER_MTOK=10.00
PRICE_CACHED_PER_MTOK=0.125
