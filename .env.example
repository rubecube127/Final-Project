# Square One — environment template
#
# Copy this file to `.env` and fill in your Portkey key. The server searches
# upward for the first `.env` it finds, so this file works in any of:
#
#     backend/.env
#     .env                        <- this location
#     ../.env                     <- one folder above the project
#     ../../.env
#
# On boot the server prints which file it loaded. Never commit a real `.env` —
# it is listed in .gitignore.

# Required. Your Portkey gateway key.
PORTKEY_API_KEY=your-portkey-key-here

# Optional — these are the defaults.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
MODEL_NAME=gpt-6-luna
PORT=3001

# Prices in US dollars per 1,000,000 tokens, used to report cost on screen.
PRICE_INPUT_PER_MTOK=1.25
PRICE_OUTPUT_PER_MTOK=10.00
